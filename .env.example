# Copy to .env / api/.env / api_dev/.env. Do not commit real secrets.

DEBUG=True
DJANGO_SECRET_KEY=change-me

# Optional. If set, Django uses this Postgres URL and ignores DB_* / SQLite.
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SSLMODE=disable

# Public domains only. Localhost is hardcoded in settings.
CORS_ALLOWED_ORIGINS=https://api.tatifarmos.com,https://adminapi.tatifarmos.com,https://dev-api.tatifarmos.com,https://www.tatifarmos.com
CORS_ALLOW_CREDENTIALS=True

# CSRF trusted origins (scheme + host). Public domains only.
CSRF_TRUSTED_ORIGINS=https://api.tatifarmos.com,https://adminapi.tatifarmos.com,https://dev-api.tatifarmos.com,https://www.tatifarmos.com

ALLOWED_HOSTS=api.tatifarmos.com,adminapi.tatifarmos.com,dev-api.tatifarmos.com,www.tatifarmos.com
